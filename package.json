{
  "name": "shizzyunchained-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:subnet-news && node scripts/generate-social-previews.mjs && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test:bubbles": "node --test --experimental-strip-types tests/bubble-timeframe.test.mjs",
    "test:charts": "node --test --experimental-strip-types tests/chart-data.test.mjs tests/chart-drawings.test.mjs",
    "validate:subnet-news": "node scripts/publish-subnet-news.mjs --check && npm run validate:owner-holdings",
    "publish:subnet-news": "node scripts/publish-subnet-news.mjs",
    "predev": "node scripts/generate-social-previews.mjs",
    "check:news-links": "node scripts/check-news-links.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "build:smoke": "npm run validate:subnet-news && node scripts/generate-social-previews.mjs && node tests/browser/build.mjs",
    "test:smoke": "playwright test",
    "check:source-text": "node scripts/check-source-text.mjs",
    "verify:release": "npm run check:source-text && npm audit --omit=dev --audit-level=high && npm run lint && npm test && npm run build:smoke && npm run test:smoke",
    "validate:owner-holdings": "node --experimental-strip-types scripts/check-owner-holdings.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^2.0.0",
    "lightweight-charts": "^5.0.9",
    "next": "^16.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.6"
    }
  }
}
