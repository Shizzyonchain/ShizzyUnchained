{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sfo1"
  ],
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci --no-audit --no-fund",
  "outputDirectory": null,
  "crons": [
    {
      "path": "/api/cron/subnet-recommendations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/validator-yield",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/root-recommendations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/etao",
      "schedule": "4,19,34,49 * * * *"
    },
    {
      "path": "/api/cron/market-signals",
      "schedule": "*/5 * * * *"
    }
  ]
}
